---
layout: null
permalink: /search.json
---
[
{% assign searchable_pages = site.pages | where_exp: "item", "item.title" %}
{% for item in searchable_pages %}
  {
    "title": {{ item.search_title | default: item.title | jsonify }},
    "url": {{ item.url | relative_url | jsonify }},
    "lang": {{ item.lang | default: site.lang | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
